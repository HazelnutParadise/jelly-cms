{
    "name": "Jelly",
    "version": "2.0.0",
    "description": "Jelly CMS 預設主題。白底墨字的通用骨架，品牌感來自不同口味、半透明疊在一起的果凍丁，以及只圓一個角的形狀。",
    "author": "Jelly Team",
    "colors": {
        "primary": "#E8285B",
        "secondary": "#2F6BFF",
        "background": "#FFFFFF",
        "text": "#15161A",
        "text_muted": "#5F6470",
        "accent": "#13C2A3",
        "link": "#2F6BFF",
        "link_hover": "#E8285B",
        "border": "#DDE0E7",
        "dark": "#15161A",
        "success": "#15A06A",
        "warning": "#F5B800",
        "error": "#E03B2E"
    },
    "layout": {
        "header_style": "sticky",
        "sidebar": false,
        "sidebar_position": "right",
        "footer": true,
        "container_width": "wide",
        "post_layout": "grid"
    },
    "custom_fields": [
        {
            "id": "tagline",
            "label": "網站標語",
            "type": "text",
            "default": "寫下來，才算數。",
            "description": "顯示在首頁刊頭與頁尾。",
            "category": "content"
        },
        {
            "id": "footer_note",
            "label": "頁尾備註",
            "type": "text",
            "default": "",
            "description": "例如版權聲明或聯絡方式，留空則不顯示。",
            "category": "content"
        }
    ]
}
